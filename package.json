{
  "name": "shadowframe-ai",
  "version": "0.3.6",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "bridge:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Shadowframe-Bridge.ps1",
    "bridge:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Stop-Shadowframe-Bridge.ps1",
    "core:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Build-Shadowframe-Core.ps1",
    "core:build:public": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Build-Shadowframe-Core.ps1 -Profile public",
    "core:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Shadowframe-Core.ps1",
    "installer:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Build-Shadowframe-Installer.ps1",
    "installer:build:public": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Build-Shadowframe-Installer.ps1 -PublicRelease",
    "installer:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Shadowframe-Installer.ps1",
    "beta:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Build-Shadowframe-BetaPackage.ps1",
    "models:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/Build-Shadowframe-ModelPacks.ps1",
    "models:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Shadowframe-ModelPack.ps1",
    "models:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Shadowframe-ModelPackArtifacts.ps1",
    "start": "vinext start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}


