<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Shadowframe Setup</AssemblyName>
    <RootNamespace>Shadowframe.Installer</RootNamespace>
    <ApplicationIcon>..\Shadowframe.Launcher\Assets\shadowframe.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <Version>0.3.6</Version>
    <Authors>Shadowframe AI</Authors>
    <Product>Shadowframe AI Setup</Product>
    <Description>Installs and repairs the private Shadowframe AI Core runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Generated\Shadowframe-Package.json" LogicalName="InstallerAssets/Shadowframe-Package.json" Condition="Exists('Generated\\Shadowframe-Package.json')" />
    <EmbeddedResource Include="Generated\Shadowframe-ReleaseProfile.json" LogicalName="InstallerAssets/Shadowframe-ReleaseProfile.json" Condition="Exists('Generated\\Shadowframe-ReleaseProfile.json')" />
    <EmbeddedResource Include="Generated\Sample-Prompts.zip" LogicalName="InstallerAssets/Sample-Prompts.zip" Condition="Exists('Generated\\Sample-Prompts.zip')" />
  </ItemGroup>
</Project>

