{
  "1": {
    "inputs": { "image": "source-image.png" },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Source Image" }
  },
  "2": {
    "inputs": { "unet_name": "anima-aesthetic-v1.1.safetensors", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Anima Model" }
  },
  "3": {
    "inputs": { "clip_name": "qwen_3_06b_base.safetensors", "type": "stable_diffusion", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Anima Text Encoder" }
  },
  "4": {
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load Anima VAE" }
  },
  "5": {
    "inputs": { "text": "masterpiece, best quality, score_7", "clip": ["3", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "6": {
    "inputs": { "text": "worst quality, low quality, blurry", "clip": ["3", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "7": {
    "inputs": { "pixels": ["1", 0], "vae": ["4", 0] },
    "class_type": "VAEEncode",
    "_meta": { "title": "Encode Source Image" }
  },
  "8": {
    "inputs": {
      "model": ["2", 0], "seed": 0, "steps": 25, "cfg": 4.5,
      "sampler_name": "er_sde", "scheduler": "simple",
      "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0], "denoise": 0.75
    },
    "class_type": "KSampler",
    "_meta": { "title": "Edit with Anima" }
  },
  "9": {
    "inputs": { "samples": ["8", 0], "vae": ["4", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Image" }
  },
  "10": {
    "inputs": { "image": ["9", 0], "upscale_method": "lanczos", "scale_by": 1.5 },
    "class_type": "ImageScaleBy",
    "_meta": { "title": "High Resolution Output" }
  },
  "11": {
    "inputs": { "images": ["10", 0], "filename_prefix": "image/ShadowframeAI_ANIMA_i2i" },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Anima Image" }
  }
}
